{% extends 'base.html.twig' %}

{% block title %}{{ 'poste_backup.destinations.title'|trans }}{% endblock %}

{% block body -%}
{% include 'Base/PosteBackup/_common.html.twig' %}
<p><a href="{{ path('poste_backup') }}"><span class="glyphicon glyphicon-chevron-left"></span> {{ 'poste_backup.title'|trans }}</a></p>
<p><a class="btn btn-primary" href="{{ path('poste_backup_destination_new') }}"><i class="fa fa-plus"></i> {{ 'poste_backup.destinations.add'|trans }}</a></p>
<table class="table table-striped table-hover bk">
    <thead><tr><th>{{ 'poste_backup.field.name'|trans }}</th><th>{{ 'poste_backup.field.type'|trans }}</th>
        <th>{{ 'poste_backup.field.location'|trans }}</th><th>{{ 'poste_backup.destinations.last_test'|trans }}</th>
        <th>{{ 'poste_backup.destinations.used_by'|trans }}</th><th>{{ 'poste_backup.destinations.space'|trans }}</th>
        <th>{{ 'poste_backup.dashboard.last_verification'|trans }}</th><th></th></tr></thead>
    <tbody>
    {% for id, d in destinations %}
        {% set t = tests[id] ?? null %}
        <tr>
            <th>{{ d.name }}</th>
            <td>{{ ('poste_backup.type.' ~ d.type)|trans }}</td>
            <td><code>{% if d.type == 'local' %}{{ d.path }}{% elseif d.type == 'sftp' %}{{ d.user }}@{{ d.host }}:{{ d.folder }}{% elseif d.type == 'smb' %}//{{ d.host }}/{{ d.share }}{% if d.folder %}/{{ d.folder }}{% endif %}{% else %}{{ d.endpoint }}/{{ d.bucket }}{% if d.folder %}/{{ d.folder }}{% endif %}{% endif %}</code></td>
            <td>{% if t is null %}<span class="bk-muted">{{ 'poste_backup.destinations.not_tested'|trans }}</span>
                {% elseif t.status == 'error' %}<span class="text-danger"><i class="fa fa-times-circle"></i> {{ t.lines|last }}</span>
                {% else %}<span class="text-success"><i class="fa fa-check"></i> {{ t.t|date('Y-m-d H:i') }}</span>{% endif %}</td>
            <td>{{ (used[id] ?? [])|join(', ') }}</td>
            <td>{% set sp = space[id] ?? null %}{% if sp is null %}<span class="bk-muted">{{ 'poste_backup.dashboard.space_unknown'|trans }}</span>
                {% else %}{% if sp.used is not null %}{{ 'poste_backup.dashboard.space_used'|trans({'{used}': sp.used}) }}{% endif %}
                {% if sp.free is not null %}<br><span class="bk-muted">{{ sp.total is not null ? 'poste_backup.dashboard.disk_free'|trans({'{free}': sp.free, '{total}': sp.total}) : 'poste_backup.dashboard.space_free'|trans({'{free}': sp.free}) }}</span>{% endif %}{% endif %}</td>
            <td>{% set last = verify[id].last ?? null %}{% if last is null %}<span class="bk-muted">{{ d.verify.every == 'never' ? 'poste_backup.verify.off'|trans : 'poste_backup.verify.never_yet'|trans }}</span>
                {% elseif last.status == 'ok' %}<span class="text-success"><i class="fa fa-check"></i> {{ last.t|date('Y-m-d H:i') }}</span>
                {% else %}<span class="text-danger"><i class="fa fa-times-circle"></i> {{ last.error }}</span>{% endif %}</td>
            <td class="text-right" style="white-space:nowrap">
                <a class="btn btn-default btn-xs" href="{{ path('poste_backup_destination_edit', {id: id}) }}">{{ 'poste_backup.action.edit'|trans }}</a>
                {% if used[id] is not defined %}
                <form method="post" action="{{ path('poste_backup_destination_delete', {id: id}) }}" style="display:inline"
                      onsubmit="return confirm('{{ 'poste_backup.destinations.delete_confirm'|trans|e('js') }}')">
                    <input type="hidden" name="_token" value="{{ csrf_token('poste_backup_destination_delete') }}">
                    <button type="submit" class="btn btn-default btn-xs"><i class="fa fa-trash"></i> {{ 'poste_backup.action.delete'|trans }}</button>
                </form>
                {% endif %}
            </td>
        </tr>
    {% else %}
        <tr><td colspan="8" class="text-center"><em>{{ 'poste_backup.destinations.none'|trans }}</em></td></tr>
    {% endfor %}
    </tbody>
</table>
<p class="help-block">{{ 'poste_backup.destinations.help'|trans }}</p>

<div class="bk-box" style="max-width:900px"><h4><i class="fa fa-tachometer"></i> {{ 'poste_backup.destinations.space_title'|trans }}</h4>
    <form method="post" class="bk-form" action="{{ path('poste_backup_space_settings') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('poste_backup_space') }}">
        <div class="bk-row">
            <div class="form-group"><label class="control-label" for="bk-warn">{{ 'poste_backup.destinations.space_warn'|trans }}</label>
                <div class="input-group" style="width:120px"><input class="form-control" id="bk-warn" name="space_warn" value="{{ settings.space_warn }}" inputmode="numeric" maxlength="2"><span class="input-group-addon">%</span></div></div>
            <div class="form-group"><label class="control-label" for="bk-full">{{ 'poste_backup.destinations.space_full'|trans }}</label>
                <div class="input-group" style="width:120px"><input class="form-control" id="bk-full" name="space_full" value="{{ settings.space_full }}" inputmode="numeric" maxlength="2"><span class="input-group-addon">%</span></div></div>
            <div class="form-group"><button type="submit" class="btn btn-primary"><i class="fa fa-check"></i> {{ 'poste_backup.action.save'|trans }}</button></div>
        </div>
        <p class="bk-muted" style="margin:0">{{ 'poste_backup.destinations.space_help'|trans }}</p>
    </form>
</div>
{% endblock %}
