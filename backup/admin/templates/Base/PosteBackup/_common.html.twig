{# messages and the add-on's styles, included at the top of every backup page #}
{% for flashMessage in app.session.flashbag.get('notice') %}
<div class="alert alert-info">{{ flashMessage }}</div>
{% endfor %}
{% for flashMessage in app.session.flashbag.get('error') %}
<div class="alert alert-danger">{{ flashMessage }}</div>
{% endfor %}
<style>
/* The admin's Font Awesome 4.3.0 writes "0{" for "0%{" in the keyframes of fa-spin (minified CSS):
   the first frame is dropped and a spinner turns by about one degree, so it looks still (measured).
   A keyframes rule of our own, on the pages of this add-on. */
@-webkit-keyframes bk-spin { from { -webkit-transform: rotate(0deg); transform: rotate(0deg); } to { -webkit-transform: rotate(360deg); transform: rotate(360deg); } }
@keyframes bk-spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
.fa-spin { -webkit-animation: bk-spin 1.2s infinite linear; animation: bk-spin 1.2s infinite linear; }
.bk-muted { color: var(--bs-secondary-color, #777); font-size: 12px; }
.bk-alert { padding: 8px 12px; margin: 14px 0 0; }
.bk-alert ul { margin: 4px 0 0; padding-left: 20px; }
.bk-status { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 14px; }
.bk-card { flex: 1 1 240px; border: 1px solid var(--bs-border-color, #ddd); border-radius: 4px; padding: 8px 12px; }
.bk-card h4 { margin: 0 0 8px; font-size: 15px; }
.bk-space { margin-bottom: 8px; }
.bk-space .bk-bar { margin: 3px 0; }
.bk-bar { height: 10px; background: var(--bs-secondary-bg, #eee); border-radius: 5px; overflow: hidden; margin: 6px 0; }
.bk-bar span { display: block; height: 100%; background: #3DC7BE; }
/* space nearly used up: yellow from 80%, red from 90% */
.bk-bar span.bk-warn { background: #f0ad4e; }
.bk-bar span.bk-full { background: #d9534f; }
/* the buttons of the dashboard: tiles like those of Poste.io's own dashboard (white text, a big
   pale icon on the right, the same greens and blues; red when something needs a look) */
.bk-nav { display: flex; flex-wrap: wrap; gap: 0.6em; margin: 20px 0 6px; }
.bk-stats-title { margin: 26px 0 8px; }
.bk-stats-title small { font-size: 13px; margin-left: 8px; }
.bk-charts { display: grid; grid-template-columns: repeat(auto-fit, minmax(380px, 1fr)); gap: 14px; }
.bk-chart { height: 220px; position: relative; }
.bk-chart-none { padding-top: 90px; text-align: center; }
.bk-nav a { flex: 1 1 180px; position: relative; min-height: 96px; padding: 1em 76px 1em 1em; color: #fff; text-decoration: none; border: none; }
.bk-nav a:hover, .bk-nav a:focus { color: #fff; text-decoration: none; filter: brightness(1.1); }
.bk-nav a i.fa { font-size: 60px; position: absolute; right: 10px; top: 50%; transform: translateY(-50%); color: rgba(255, 255, 255, 0.5); }
.bk-nav strong { display: block; font-size: 22px; font-weight: normal; line-height: 1.2; margin-bottom: 4px; }
.bk-nav .bk-muted { color: rgba(255, 255, 255, 0.9); }
.bk-nav .bk-tile1 { background-color: #29A200; }
.bk-nav .bk-tile2 { background-color: #00AE46; }
.bk-nav .bk-tile3 { background-color: #00B383; }
.bk-nav .bk-tile4 { background-color: #00AEB9; }
.bk-nav .bk-tile5 { background-color: #0098C4; }
.bk-nav a.bk-tile-bad { background-color: #d9534f; }
.bk-form { max-width: 900px; }
.bk-form .form-group { margin-bottom: 14px; }
.bk-row { display: flex; flex-wrap: wrap; gap: 8px 24px; align-items: flex-end; }
.bk-row .form-group { min-width: 160px; }
.bk-form .control-label { display: block; margin-bottom: 4px; }
.bk-small { width: 80px !important; display: inline-block !important; }
.bk-box { border: 1px solid var(--bs-border-color, #ddd); border-radius: 4px; padding: 10px 14px; margin: 14px 0; }
.bk-box h4 { margin: 0 0 8px; font-size: 15px; }
table.bk td, table.bk th { vertical-align: middle !important; }
code.bk-key { display: block; white-space: pre-wrap; word-break: break-all; padding: 8px; }
pre.bk-log { max-height: 70vh; overflow: auto; white-space: pre-wrap; word-break: break-all; font-size: 12px; }
</style>
