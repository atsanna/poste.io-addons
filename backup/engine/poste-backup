#!/usr/bin/php
<?php
/*
 * poste.io-addons, backup add-on: command line of the engine. It runs as the
 * user "mail" (cron starts it as mail; started as root it switches to mail).
 *
 *   poste-backup tick                    run what is due (cron, every minute)
 *   poste-backup run <job id>            run a job now
 *   poste-backup status                  last results (state.json)
 *   poste-backup restic <dest id> <...>  restic on a destination's repository,
 *                                        with its settings and the key: for
 *                                        listing and restoring by hand, e.g.
 *       poste-backup restic 0a1b2c3d4e5f snapshots
 *       poste-backup restic 0a1b2c3d4e5f restore latest --target /tmp/r --include /data/domains/example.com/alice
 *
 * The ids are in the admin (Backup > Destinations / Backup jobs) and in
 * /data/var/backup/settings/config.json.
 */

namespace PosteBackup;

foreach (['Config', 'Store', 'Schedule', 'Proc', 'Destination', 'Engine'] as $c) {
    require "/usr/local/lib/poste-backup/lib/$c.php";
}

if (PHP_SAPI !== 'cli') {
    exit(1);
}
// everything runs as "mail", like the admin: started as root (docker exec,
// a manual restore), it hands over to mail before doing anything
$mail = posix_getpwnam('mail');
if ($mail === false) {
    fwrite(STDERR, "poste-backup: no user mail\n");
    exit(1);
}
if (posix_geteuid() === 0) {
    // at a terminal, mail gets a pseudo-terminal of its own (-P), never root's
    $pty = posix_isatty(STDIN) ? ['-P'] : [];
    pcntl_exec('/usr/sbin/runuser', array_merge($pty, ['-u', 'mail', '--', '/usr/local/bin/poste-backup'], array_slice($argv, 1)));
    fwrite(STDERR, "poste-backup: cannot switch to the user mail\n");
    exit(1);
}
if (posix_geteuid() !== $mail['uid']) {
    fwrite(STDERR, "poste-backup: run it as root or as mail\n");
    exit(1);
}
umask(0027);

$cmd = $argv[1] ?? '';
switch ($cmd) {
    case 'tick':
        echo (new Engine())->tick(time()), "\n";
        exit(0);

    case 'run':
        $id = $argv[2] ?? '';
        if (!Config::isId($id)) {
            fwrite(STDERR, "usage: poste-backup run <job id>\n");
            exit(2);
        }
        $r = (new Engine())->runNow($id);
        echo $r, "\n";
        exit(preg_match('/: ok$/', $r) ? 0 : 1);

    case 'status':
        echo json_encode(Store::readJson(Store::STATE) ?? [], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES), "\n";
        exit(0);

    case 'restic':
        $id = $argv[2] ?? '';
        $raw = Store::readJson(Store::CONFIG);
        [$cfg, $errors] = Config::validate($raw ?? Config::empty());
        if (!Config::isId($id) || !isset($cfg['destinations'][$id])) {
            fwrite(STDERR, "usage: poste-backup restic <destination id> <restic arguments...>\n");
            exit(2);
        }
        $d = $cfg['destinations'][$id];
        $tmp = Store::TMP . '/' . bin2hex(random_bytes(6));
        mkdir($tmp, 0700);
        [$env, $err] = Destination::env($id, $d, $tmp, Store::CACHE);
        if ($err) {
            fwrite(STDERR, "poste-backup: $err\n");
            exit(1);
        }
        $env += ['RESTIC_PASSWORD_FILE' => Store::KEY, 'RESTIC_CACHE_DIR' => Store::CACHE . '/restic',
                 'PATH' => Proc::PATH, 'LANG' => 'C.UTF-8'];
        // the terminal stays attached: restic's own output and prompts
        $p = proc_open(array_merge(['restic', '-r', Destination::repository($id, $d)], array_slice($argv, 3)),
                       [0 => STDIN, 1 => STDOUT, 2 => STDERR], $pipes, null, $env);
        $exit = is_resource($p) ? proc_close($p) : 127;
        foreach (glob("$tmp/*") ?: [] as $f) {
            unlink($f);
        }
        rmdir($tmp);
        exit($exit);

    default:
        fwrite(STDERR, "usage: poste-backup tick | run <job id> | status | restic <destination id> <restic arguments...>\n");
        exit(2);
}
