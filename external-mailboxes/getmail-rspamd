#!/usr/bin/python3
"""getmail filter of External Mailboxes: scan a fetched message with rspamd.

Mail fetched by getmail is delivered through the local submission socket of
Haraka, which does not ask rspamd about local connections: without this filter
it would reach the mailbox unchecked. getmail runs this program with the
message on stdin and delivers what it prints:

- the message with the headers that Haraka adds to mail received over SMTP
  (X-Rspamd-Score, X-Rspamd-Bar, X-Rspamd-Report; existing ones are replaced,
  so that a sender cannot forge them), and the header changes that rspamd asks
  for (its "milter" answer, applied by Haraka too: e.g. a forged X-Spam is
  removed);
- from the score at which Poste.io marks spam (munge_subject in
  quarantine_decide.ini, 6 by default) the same subject prefix, which the sieve
  rule of the mailbox files into Junk. Above the quarantine score Haraka would
  hold the message back; here it goes to Junk too, so nothing fetched is lost.

The scan has no connection behind it (the message comes from a mailbox, not
from an SMTP client): checks that need the client's address or name do not
apply, and the one that would fire on every message (unknown hostname) is
switched off. Content, links, DKIM, Bayes (per domain of the recipient) and
fuzzy hashes work as for SMTP mail.

If rspamd cannot be asked, the message is printed unchanged and the reason
goes to the getmail errors log ("Getmail Errors" in the admin): nothing is
lost or held back. Nothing is written to stderr, because getmail does not
deliver a message whose filter writes there.

usage: getmail-rspamd <recipient address>
"""
import configparser
import json
import math
import os
import re
import subprocess
import sys
import time

ERROR_LOG = "/data/log/getmail/errors.log"
DECIDE_INI = "/opt/haraka-smtp/config/quarantine_decide.ini"
HEADERS = ("X-Rspamd-Score", "X-Rspamd-Bar", "X-Rspamd-Report")
# symbols that only depend on the SMTP connection, which does not exist here
DISABLED = ["HFILTER_HOSTNAME_UNKNOWN"]


def log_error(rcpt, text):
    try:
        with open(ERROR_LOG, "a") as f:
            # one line per event, like the other lines of the errors log
            f.write("%s getmail-rspamd (%s): %s\n" % (time.strftime("%Y-%m-%d %H:%M:%S"), rcpt, " ".join(str(text).split())))
    except OSError:
        pass


def spam_marking():
    """Score and subject prefix that Poste.io uses to mark spam."""
    cfg = configparser.ConfigParser(interpolation=None)
    try:
        cfg.read(DECIDE_INI)
        score = float(cfg.get("rspamd", "munge_subject", fallback="6"))
        prefix = cfg.get("rspamd", "prefix", fallback="*****SPAM*****").strip()
    except (configparser.Error, ValueError):
        score, prefix = 6.0, "*****SPAM*****"
    return score, prefix or "*****SPAM*****"


def scan(message, rcpt):
    settings = json.dumps({"symbols_disabled": DISABLED})
    # cron (PAM) sets LANG=en_US.UTF-8, a locale the image does not have:
    # rspamc aborts on it ("locale::facet::_S_create_c_locale name not valid")
    env = dict(os.environ, LC_ALL="C")
    r = subprocess.run(["rspamc", "--json", "-t", "60", "--rcpt", rcpt, "--header", "Settings=" + settings],
                       input=message, stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=env, timeout=120)
    if r.returncode != 0:
        # rspamc writes some errors (e.g. "Connection failed") on stdout
        err = " ".join((r.stderr or r.stdout).decode(errors="replace").split())
        raise RuntimeError("rspamc exit %d: %s" % (r.returncode, err[:200]))
    data = json.loads(r.stdout.decode(errors="replace"))
    if "score" not in data:
        raise RuntimeError("rspamd answered without a score: %s" % r.stdout.decode(errors="replace")[:200])
    return data


def spam_bar(score):
    # same as Haraka's rspamd plugin
    if score >= 1:
        return "+" * math.floor(score)
    if score <= -1:
        return "-" * math.floor(-score)
    return "/"


def report(symbols):
    return " ".join("%s(%s)" % (s["name"], format_number(s["score"]))
                    for s in symbols.values() if s.get("score"))


def format_number(n):
    # 5.0 -> 5, -0.1 -> -0.1 (as JavaScript prints numbers in Haraka's headers)
    return ("%.6f" % n).rstrip("0").rstrip(".") if n != int(n) else str(int(n))


def milter(data):
    """Header names to remove and headers to add, as rspamd asks Haraka."""
    m = data.get("milter") or {}
    remove = list(m.get("remove_headers") or {})
    add = [(k, v.get("value", "") if isinstance(v, dict) else v)
           for k, v in (m.get("add_headers") or {}).items()]
    return remove, add


def rewrite(message, data, threshold, prefix):
    end = re.search(rb"\r?\n\r?\n", message)
    head, body = (message[:end.start()], message[end.start():]) if end else (message, b"")
    nl = b"\r\n" if b"\r\n" in head[:1000] else b"\n"
    lines = re.split(rb"\r?\n", head)

    remove, add = milter(data)
    # drop existing X-Rspamd-* headers and those rspamd asks to remove,
    # with their continuation lines
    kept, skipping = [], False
    names = tuple(h.lower().encode() + b":" for h in list(HEADERS) + remove)
    for line in lines:
        if line[:1] in (b" ", b"\t") and skipping:
            continue
        skipping = line.lower().startswith(names)
        if not skipping:
            kept.append(line)

    score = float(data["score"])
    if score >= threshold:
        p = prefix.encode()
        for i, line in enumerate(kept):
            m = re.match(rb"(?i)subject:[ \t]*", line)
            if m:
                if not line[m.end():].startswith(p):
                    kept[i] = line[:m.end()] + p + b" " + line[m.end():]
                break
        else:
            kept.insert(0, b"Subject: " + p)

    added = [b"X-Rspamd-Score: " + format_number(score).encode(),
             b"X-Rspamd-Bar: " + spam_bar(score).encode(),
             b"X-Rspamd-Report: " + report(data.get("symbols") or {}).encode()]
    added += [("%s: %s" % (k, v)).encode() for k, v in add]
    return nl.join(added + kept) + body


def main():
    rcpt = sys.argv[1] if len(sys.argv) > 1 else ""
    message = sys.stdin.buffer.read()
    out = message
    try:
        threshold, prefix = spam_marking()
        out = rewrite(message, scan(message, rcpt), threshold, prefix)
    except Exception as e:  # never lose or hold back a message
        log_error(rcpt, "delivered without the rspamd check: %s" % e)
        out = message
    sys.stdout.buffer.write(out)
    sys.stdout.buffer.flush()


if __name__ == "__main__":
    main()
