#!/bin/sh
# External Mailboxes: writes /etc/logrotate.d/external-mailboxes from the log
# rotation settings saved in the admin (/data/var/getmail/log-rotation.ini).
# Runs as root from cron just before Poste.io's nightly logrotate, and once at
# build time (default rule). The admin runs as "mail" and cannot write
# logrotate rules itself.
#
# The settings file is written by a less privileged user: nothing in it is
# executed, and every value must be one of the allowed ones, otherwise the
# default is used.

SETTINGS=/data/var/getmail/log-rotation.ini
RULE=/etc/logrotate.d/external-mailboxes

# value <key> <default> <allowed values...>
value() {
    key=$1
    def=$2
    shift 2
    v=""
    if [ -f "$SETTINGS" ] && [ ! -L "$SETTINGS" ]; then
        v=$(sed -n "s/^$key=\([A-Za-z0-9]*\)\$/\1/p" "$SETTINGS" | head -n 1)
    fi
    for ok in "$@"; do
        if [ "$v" = "$ok" ]; then
            echo "$v"
            return
        fi
    done
    echo "$def"
}

enabled=$(value enabled 1 0 1)
every=$(value getmail_every weekly daily weekly monthly)
size=$(value errors_size 1M 512k 1M 5M 10M)
keep=$(value keep 4 1 2 4 8 12)

tmp=$(mktemp /etc/.external-mailboxes-logrotate.XXXXXX) || exit 1
{
    echo "# Generated by external-mailboxes-logrotate from $SETTINGS"
    echo "# (admin: External Mailbox Logs > Rotation). Do not edit: rewritten every night."
    if [ "$enabled" = 1 ]; then
        cat <<EOF

# getmail.log, written by getmail as "mail"; the folder belongs to mail, hence "su"
/data/log/getmail/getmail.log {
    $every
    rotate $keep
    compress
    delaycompress
    missingok
    notifempty
    su mail mail
    create 0640 mail mail
}

# errors.log is rotated by size, not by date: the admin's red line reads the
# last 24 hours from this file only, and a rotation by date would hide the
# errors of the night before
/data/log/getmail/errors.log {
    size $size
    rotate $keep
    compress
    delaycompress
    missingok
    notifempty
    su mail mail
    create 0640 mail mail
}
EOF
    else
        echo "# Rotation switched off in the admin: the getmail logs are not rotated."
    fi
} > "$tmp" && chmod 0644 "$tmp" && mv "$tmp" "$RULE" || { rm -f "$tmp"; exit 1; }
