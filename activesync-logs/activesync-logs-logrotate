#!/bin/sh
# ActiveSync Logs: writes /etc/logrotate.d/activesync-logs from the log
# rotation settings saved in the admin (/data/var/activesync-logs/log-rotation.ini).
# Runs as root from cron just before Poste.io's nightly logrotate, at every
# container start, and once at build time (default rule). The admin runs as
# "mail" and cannot write logrotate rules itself.
#
# The settings file is written by a less privileged user: nothing in it is
# executed, and every value must be one of the allowed ones, otherwise the
# default is used.

SETTINGS=/data/var/activesync-logs/log-rotation.ini
RULE=/etc/logrotate.d/activesync-logs

# value <key> <default> <allowed values...>
value() {
    key=$1
    def=$2
    shift 2
    v=""
    if [ -f "$SETTINGS" ] && [ ! -L "$SETTINGS" ]; then
        v=$(sed -n "s/^$key=\([A-Za-z0-9]*\)\$/\1/p" "$SETTINGS" | head -n 1)
    fi
    for ok in "$@"; do
        if [ "$v" = "$ok" ]; then
            echo "$v"
            return
        fi
    done
    echo "$def"
}

enabled=$(value enabled 1 0 1)
zpush=$(value zpush_every weekly daily weekly monthly)
errors=$(value errors_every weekly daily weekly monthly)
keep=$(value keep 4 1 2 4 8 12)

tmp=$(mktemp /etc/.activesync-logs-logrotate.XXXXXX) || exit 1
{
    echo "# Generated by activesync-logs-logrotate from $SETTINGS"
    echo "# (admin: ActiveSync Logs > Rotation). Do not edit: rewritten every night."
    if [ "$enabled" = 1 ]; then
        for pair in "z-push.log:$zpush" "z-push-error.log:$errors"; do
            cat <<EOF

# Written by Z-Push (php-fpm, www-data), which opens the file again for every
# line: no copytruncate needed. The folder belongs to www-data, hence "su".
/data/log/z-push/${pair%%:*} {
    ${pair#*:}
    rotate $keep
    compress
    delaycompress
    missingok
    notifempty
    su www-data www-data
    create 0644 www-data www-data
}
EOF
        done
    else
        echo "# Rotation switched off in the admin: the Z-Push logs are not rotated."
    fi
} > "$tmp" && chmod 0644 "$tmp" && mv "$tmp" "$RULE" || { rm -f "$tmp"; exit 1; }
