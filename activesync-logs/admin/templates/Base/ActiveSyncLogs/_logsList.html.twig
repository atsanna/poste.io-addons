<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th width="5%">{{ 'activesync_logs.level.label'|trans }}</th>
                <th width="15%">{{ 'activesync_logs.timestamp.label'|trans }}</th>
                <th width="15%">{{ 'activesync_logs.account.label'|trans }}</th>
                <th width="65%">{{ 'activesync_logs.message.label'|trans }}</th>
            </tr>
        </thead>
        <tbody>
        {% for log in logs %}
            <tr data-log="{{ loop.index }}" class="log-level-{{ log.level }}">
                <td>
                    {% if log.level == 'error' %}
                        <span class="label label-danger" title="{{ log.levelName }}"><i class="fa fa-exclamation-triangle"></i></span>
                    {% elseif log.level == 'warning' %}
                        <span class="label label-warning" title="{{ log.levelName }}"><i class="fa fa-exclamation"></i></span>
                    {% else %}
                        <span class="label label-info" title="{{ log.levelName }}"><i class="fa fa-info"></i></span>
                    {% endif %}
                </td>
                <td>
                    <small>{{ log.timestamp }}</small>
                </td>
                <td>
                    <small>{{ log.account }}</small>
                </td>
                <td>
                    <div class="log-message">{{ log.message|nl2br }}</div>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4" class="text-center">
                    <em>{{ 'activesync_logs.no_logs'|trans }}</em>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>

<style>
.log-level-error { background-color: #f2dede; }
.log-level-warning { background-color: #fcf8e3; }
.log-message { font-family: 'Courier New', monospace; font-size: 12px; word-break: break-word; }
</style>
